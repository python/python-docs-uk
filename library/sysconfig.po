msgstr ":file:`{userbase}/lib/python{X.Y}/site-packages`"

msgid "*purelib*"
msgstr ""

msgid "*include*"
msgstr ""

msgid ":file:`{userbase}/include/python{X.Y}`"
msgstr ""

msgid "*scripts*"
msgstr "*скрипти*"

msgid ":file:`{userbase}/bin`"
msgstr ":file:`{userbase}/bin`"

msgid "*data*"
msgstr "*дані*"

