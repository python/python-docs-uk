msgstr "Введіть код"

msgid "C Type"
msgstr "C Тип"

msgid "Python Type"
msgstr "Тип Python"

msgid "Minimum size in bytes"
msgstr "Мінімальний розмір у байтах"

msgid "Notes"
msgstr "Примітки"

